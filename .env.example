# =========================================================
# 로파워 Admin - Vercel / .env.local 예시
# =========================================================

# 1) Branding (브라우저에 노출되는 공개 환경변수)
NEXT_PUBLIC_BRAND_NAME=로파워
# 고객 안내문 발신명. 협업 로펌명으로 변경 가능 (예: 법무법인 OOO)
NEXT_PUBLIC_NOTICE_SENDER_NAME=로파워
# 계좌/입금 안내 하단문구. 필요 없으면 빈 값으로 두세요.
NEXT_PUBLIC_BANK_NOTICE=

# 2) Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
# 서버에서만 사용하는 Service Role Key. 절대 NEXT_PUBLIC_ 접두사를 붙이지 마세요.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# 3) Google Sheet -> Admin 신규 DB
GOOGLE_SHEET_INGEST_SECRET=change-this-to-a-long-random-string

# 선택: 신규 DB Telegram 알림
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 4) Meta CRM Conversions API
META_CRM_DATASET_ID=
META_CRM_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v26.0
# 테스트 중에만 입력, 운영 시 비워도 됨
META_CRM_TEST_EVENT_CODE=

# 5) Meta Webhook (선택 - 현재 기본 수집 경로는 Google Sheet)
META_WEBHOOK_VERIFY_TOKEN=change-this-to-a-long-random-string
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=

# 6) eformsign (선택)
# 협업 로펌의 별도 계정/템플릿 값을 사용하세요. 기존 태광 키를 복사하지 마세요.
EFORMSIGN_API_KEY=
EFORMSIGN_TEMPLATE_ID=
EFORMSIGN_MEMBER_ID=
EFORMSIGN_SENDER_MEMBER_ID=
EFORMSIGN_PRIVATE_KEY=
